# ---------------------------------------------------------------------------
# Backend (required)
# ---------------------------------------------------------------------------
# Comma-separated key pool, at least 2 keys. Ids are key_1, key_2, ... in this order.
# Tip for Gemini: create each key in a *different* Google Cloud project, otherwise
# they share one quota and fail over into the same rate limit.
LLM_API_KEYS=your-first-api-key,your-second-api-key

# SQLite location. In Docker this sits on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins (your deployed frontend URL goes here too).
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure test hook.
ENABLE_FAILURE_SIMULATION=true

# ---------------------------------------------------------------------------
# Backend (optional, defaults shown)
# ---------------------------------------------------------------------------
# Any LiteLLM model name your keys can use, e.g. gemini/gemini-3.5-flash-lite, groq/llama-3.3-70b-versatile.
# List Gemini models for a key: curl -H "x-goog-api-key: $KEY" https://generativelanguage.googleapis.com/v1beta/models
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional per-key model override, aligned with LLM_API_KEYS (empty entry = LLM_MODEL).
# Lets the pool span models/providers, e.g. gemini/gemini-3.5-flash-lite,groq/llama-3.3-70b-versatile
LLM_KEY_MODELS=
# Leave empty for Gemini 3+ (it deprecates sampling params); set e.g. 0.3 for other providers.
LLM_TEMPERATURE=
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=20
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant. Answer clearly and accurately. If you are unsure about something, say so.
# How many stored messages are sent back to the model as context.
HISTORY_MAX_MESSAGES=40

# LiteLLM response cache: disk (persists in /data) or local (in-memory).
CACHE_ENABLED=true
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
CACHE_TTL_SECONDS=604800

# A key that returns a real 429 rests this long (or the provider's Retry-After); 401/403 rests longer.
KEY_COOLDOWN_SECONDS=30
KEY_AUTH_COOLDOWN_SECONDS=600
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Docker image: injected into /config.js at container start.
API_BASE_URL=http://localhost:8000
# Static hosts (Vercel/Netlify/Render static): baked in at build time.
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Docker build (optional)
# ---------------------------------------------------------------------------
# Pull base images through a mirror if Docker Hub rate-limits you, e.g. mirror.gcr.io/library/
DOCKER_REGISTRY_MIRROR=
